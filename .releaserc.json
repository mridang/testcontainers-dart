{
  "branches": [
    "master"
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "perl -i -pe 's/^(version:\\s*).*/${1}${nextRelease.version}/' packages/testcontainers_core/pubspec.yaml packages/testcontainers_compose/pubspec.yaml",
        "publishCmd": "(cd packages/testcontainers_core && dart pub publish --force) && (cd packages/testcontainers_compose && dart pub publish --force)"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": []
      }
    ],
    [
      "@semantic-release/git",
      {
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}",
        "assets": [
          "packages/testcontainers_core/pubspec.yaml",
          "packages/testcontainers_compose/pubspec.yaml"
        ]
      }
    ]
  ]
}
